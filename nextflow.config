params {
    output_dir = 'results'
    run_ai_analysis = false
}

process {
    // ProcessRepo uses Python container and installs git/procps (works with Wave)
    // Note: procps must be installed before Nextflow wrapper runs, so we use a container
    // that has it, or install it in a way that's available immediately
    withName: ProcessRepo {
        container = 'python:3.11'
    }
    // Other processes define containers in their module files
}

// Almanack authenticates its GitHub API calls with GITHUB_TOKEN, raising the rate limit from
// 60 requests an hour to 5,000. It is forwarded from the launch environment rather than
// declared as a Nextflow secret so that a run without a token still completes: RunAlmanack
// sets errorStrategy 'ignore', which would turn a missing required secret into every
// repository being skipped with no error raised. Without the token Almanack makes the calls
// anonymously, and its remote metrics come back empty once the quota runs out. Only set when
// present, since an empty value warns once per task.
if (System.getenv('GITHUB_TOKEN')) {
    env.GITHUB_TOKEN = System.getenv('GITHUB_TOKEN')
}

workDir = 'work'

docker {
    enabled = true
}

executor {
    cpus = 4
    memory = '16 GB'
}

profiles {
    tower {
        process.executor = 'awsbatch'
        docker.enabled = true
        workDir = 's3://mc2-project-tower-scratch/work'
        params.output_dir = 's3://mc2-project-tower-bucket/cc_toolkit/output'
        
        // Disable Wave - AWS Batch can pull Docker images directly from Docker Hub
        wave {
            enabled = false
        }
        
        // ProcessRepo container override (other containers defined in modules)
        // Use python:3.11 (full) which may have more tools, or ensure procps is available
        process {
            withName: ProcessRepo {
                container = 'python:3.11'
            }
        }
    }
}