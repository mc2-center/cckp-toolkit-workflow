params {
    output_dir = 'results'
    upload_to_synapse = false
    synapse_folder_id = null
    use_gpt = false
}

process {
    // ProcessRepo uses Python container and installs git (works with Wave)
    withName: ProcessRepo {
        container = 'python:3.11-slim'
    }
    // Other processes define containers in their module files
}

workDir = 'work'

docker {
    enabled = true
}

executor {
    cpus = 4
    memory = '16 GB'
}

profiles {
    tower {
        process.executor = 'awsbatch'
        docker.enabled = true
        workDir = 's3://mc2-project-tower-scratch/work'
        params.output_dir = 's3://mc2-project-tower-bucket/cc_toolkit/output'
        
        // Disable task metrics to avoid ps requirement
        trace = false
        timeline = false
        report = false
        
        // Disable Wave - AWS Batch can pull Docker images directly from Docker Hub
        wave {
            enabled = false
        }
        
        // ProcessRepo container override (other containers defined in modules)
        process {
            withName: ProcessRepo {
                container = 'python:3.11-slim'
            }
        }
    }
}