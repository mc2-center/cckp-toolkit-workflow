# Copy this file to .env and fill in real values. The .env file is git-ignored.
#
# These are only needed for the data-collection / classification scripts
# (see analysis/README.md). The figure-reproduction scripts need none of them.
# Scripts load this file automatically via python-dotenv when run from the repo root.

# GitHub API token: repo discovery + README fetch (avoids the 60/hr public rate limit).
GITHUB_TOKEN=ghp_your_token_here

# Anthropic API key: primary domain classifier (analysis/data_collection/classify_domains_primary.py).
ANTHROPIC_API_KEY=sk-ant-your_key_here

# Optional: alternate LLM classifiers kept in analysis/archive/ (not needed to reproduce the paper).
OPENAI_API_KEY=sk-your_key_here
GEMINI_API_KEY=your_gemini_key_here
